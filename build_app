#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

usage() {
  cat << 'EOF'
usage: ./build_app [--server-only] [--all] [--skip-web] [--debug] [--bundles LIST] [--clean] [--yes]

Builds form.md start to finish: the desktop app for this computer, with the server inside it.
  1. checks Go 1.26+ and Node 22+
  2. installs the web client's packages when they are missing
  3. builds the web client into web/dist (embedded into the binary)
  4. regenerates NOTICES.md from the dependency licences
  5. compiles bin/form-md for this computer
  6. checks the desktop toolchain (Rust through rustup, the Xcode tools on a Mac, WebKitGTK on Linux)
  7. bundles the desktop app: form.md.app and a .dmg on macOS; .deb, .rpm and .AppImage on Linux,
     in src-tauri/target/release/bundle

Options:
  --server-only    stop after step 5 (the server binary alone, as before 0.43.0)
  --all            every server release target into release/ with SHA256SUMS, no desktop app
  --skip-web       reuse the web client already in web/dist
  --debug          a debug build of the desktop app
  --bundles LIST   which desktop packages, for example app or deb,appimage
  --clean          clear the Rust build cache and the old server copy first
  --yes            answer yes to installing Rust or the Linux packages

On Windows run build_app.bat. Run the server alone with ./bin/form-md (or ./form-md serve-built).
EOF
}

all=0
skip_web=0
server_only=0
desktop_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --all) all=1 ;;
    --skip-web) skip_web=1 ;;
    --server-only) server_only=1 ;;
    --debug|--clean|--yes|-y) desktop_args+=("$1") ;;
    --bundles)
      [ $# -ge 2 ] || { printf '[build_app] --bundles needs a list\n' >&2; exit 2; }
      desktop_args+=("$1" "$2"); shift ;;
    --bundles=*) desktop_args+=("--bundles" "${1#--bundles=}") ;;
    --config)
      [ $# -ge 2 ] || { printf '[build_app] --config needs JSON\n' >&2; exit 2; }
      desktop_args+=("$1" "$2"); shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf '[build_app] unknown option: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

say() { printf '[build_app] %s\n' "$*"; }
die() { printf '[build_app] %s\n' "$*" >&2; exit 1; }

command -v go >/dev/null 2>&1 || die "Go 1.26 or newer is required: https://go.dev/dl/"
command -v node >/dev/null 2>&1 || die "Node 22 or newer is required: https://nodejs.org/"
export GOTOOLCHAIN="${GOTOOLCHAIN:-auto}"
node_major="$(node -p 'process.versions.node.split(".")[0]')"
[ "$node_major" -ge 22 ] || die "Node 22 or newer is required (found $(node -v))"

version="v$(node -p 'require("./web/package.json").version')"
case "$version" in
  v[0-9]*.[0-9]*.[0-9]*) ;;
  *) die "web/package.json carries no x.y.z version" ;;
esac
say "form.md $version"

if [ "$skip_web" -eq 0 ]; then
  if [ ! -d web/node_modules ]; then
    say "installing the web client's packages"
    (cd web && npm ci --no-audit --no-fund)
  fi
  say "building the web client"
  (cd web && npm run build)
fi
[ -f web/dist/index.html ] || die "web/dist/index.html is missing: run without --skip-web"

say "writing NOTICES.md"
go run ./tools/notices

ldflags="-s -w -X github.com/nodemode-ai/form.md/internal/app.Version=$version"
if [ "$all" -eq 0 ]; then
  mkdir -p bin
  ext=""
  [ "$(go env GOOS)" = windows ] && ext=".exe"
  say "compiling bin/form-md$ext for $(go env GOOS)/$(go env GOARCH)"
  CGO_ENABLED=0 go build -trimpath -ldflags "$ldflags" -o "bin/form-md$ext" ./cmd/form-md
  say "done: bin/form-md$ext ($(du -h "bin/form-md$ext" | cut -f1))"
  [ "$server_only" -eq 1 ] && exit 0
  exec tools/build_desktop "$version" "bin/form-md$ext" ${desktop_args[@]+"${desktop_args[@]}"}
fi

rm -rf release
mkdir -p release
for target in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64; do
  os="${target%/*}"
  arch="${target#*/}"
  ext=""
  [ "$os" = windows ] && ext=".exe"
  out="release/form-md_${version}_${os}_${arch}${ext}"
  say "compiling $out"
  GOOS="$os" GOARCH="$arch" CGO_ENABLED=0 go build -trimpath -ldflags "$ldflags" -o "$out" ./cmd/form-md
done
(cd release && if command -v sha256sum >/dev/null 2>&1; then sha256sum form-md_* > SHA256SUMS; else shasum -a 256 form-md_* > SHA256SUMS; fi)
say "done: release/ with SHA256SUMS"
