{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "form.md",
  "mainBinaryName": "form-md-desktop",
  "version": "0.49.3",
  "identifier": "ai.nodemode.formmd",
  "build": { "frontendDist": "splash" },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "form.md",
        "url": "index.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Documents and databases for people and agents",
    "longDescription": "form.md is a workspace of pages, documents and databases that you and your agents edit together. The desktop app runs a private form.md server on this computer and keeps your data in the form.md folder in your home folder.",
    "publisher": "NodeAgentc, Inc.",
    "copyright": "Copyright 2026 NodeAgentc, Inc. Apache-2.0",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "externalBin": ["binaries/form-md-server"],
    "resources": { "NOTICES.md": "NOTICES.md", "../NOTICES.md": "NOTICES-server.md", "../LICENSE": "LICENSE" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0", "hardenedRuntime": true, "entitlements": "entitlements.plist" },
    "linux": {
      "deb": { "section": "office", "recommends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "gstreamer1.0-libav"] },
      "rpm": { "recommends": ["gstreamer1-plugins-base", "gstreamer1-plugins-good"] },
      "appimage": { "bundleMediaFramework": true }
    }
  }
}
